{
  "name": "@loonfs/sdk",
  "version": "0.5.0",
  "description": "TypeScript SDK for LoonFS applications and proxies",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loonfs/loonfs-sdk-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/loonfs/loonfs-sdk-typescript/issues"
  },
  "homepage": "https://github.com/loonfs/loonfs-sdk-typescript#readme",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "exports": {
    "./proxy": {
      "types": "./dist/proxy/proxy.d.ts",
      "default": "./dist/proxy/proxy.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && npm run build:server && npm run build:proxy",
    "build:server": "tsc",
    "build:proxy": "tsc --project proxy/tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^18.19.0"
  }
}
